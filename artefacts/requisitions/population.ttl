@prefix ph: <https://potato-hamlet.example/ontology/> .
@prefix gfo-core: <https://w3id.org/gfo-core/> .
@prefix gfo-light: <https://w3id.org/gfo-light/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Seed instances for requisitions. Individuals only — the schema lives in
# ontology.ttl. Loaded into the runtime graph at session start.
#
# No requisition is seeded. They are minted by the `lodge` act, which is the
# point of this law: the consumer has to create several ongoing instances of
# one Process type before it can be asked to choose between them.

# --- Population (every citizen carries ph:label and ph:age) ---

<https://potato-hamlet.example/ontology/citizen/ada> a ph:Citizen ;
  ph:label "Ada" ;
  ph:age 68 .

<https://potato-hamlet.example/ontology/citizen/barnaby> a ph:Citizen ;
  ph:label "Barnaby" ;
  ph:age 55 .

<https://potato-hamlet.example/ontology/citizen/cleo> a ph:Citizen ;
  ph:label "Cleo" ;
  ph:age 47 .

<https://potato-hamlet.example/ontology/hamlet> a ph:Hamlet ;
  ph:label "Potato Hamlet" .

<https://potato-hamlet.example/ontology/townhall> a ph:Townhall ;
  ph:label "The Townhall" .

# --- Clock: the current simulated position ---

<https://potato-hamlet.example/ontology/clock/now> a ph:Clock ;
  ph:label "Now" ;
  ph:dayIndex 0 ;
  ph:atHour 10 .

# --- Calendar. atDate is display-only; the oracle owns day arithmetic.
# One window bounds the requisition's whole life: it opens on day 0 and closes
# on day 30. Settling happens at the deadline on day 14, which is a POINT and
# lies INSIDE that window -- so a requisition ended by settling ends at a
# declared calendar moment, while one ended by withdrawal part-way through
# consideration ends at a moment that is not one. Both record the same way.

<https://potato-hamlet.example/ontology/calendar/2027/window> a ph:CalendarSpan ;
  ph:label "Requisition window, Jan 2 to Feb 1" ;
  ph:dayIndex 0 ;
  ph:marksPhase ph:LodgeRequisition ;
  ph:marksPhase ph:ConsiderRequisition ;
  ph:marksPhase ph:WithdrawRequisition ;
  ph:marksPhase ph:Requisition ;
  gfo-core:temporallyStartedBy
    <https://potato-hamlet.example/ontology/calendar/2027/opens> ;
  gfo-core:temporallyFinishedBy
    <https://potato-hamlet.example/ontology/calendar/2027/closes> .

<https://potato-hamlet.example/ontology/calendar/2027/opens> a ph:CalendarPoint ;
  ph:label "Window opens, Jan 2" ;
  ph:atDate "2027-01-02"^^xsd:date ;
  ph:dayIndex 0 ;
  ph:atHour 9 .

<https://potato-hamlet.example/ontology/calendar/2027/deadline> a ph:CalendarPoint ;
  ph:label "Settling deadline, Jan 16" ;
  ph:atDate "2027-01-16"^^xsd:date ;
  ph:dayIndex 14 ;
  ph:atHour 18 ;
  ph:marksPhase ph:SettleRequisition .

<https://potato-hamlet.example/ontology/calendar/2027/closes> a ph:CalendarPoint ;
  ph:label "Window closes, Feb 1" ;
  ph:atDate "2027-02-01"^^xsd:date ;
  ph:dayIndex 30 ;
  ph:atHour 18 .

# --- Process situations, so the verdict's `phase` resolves by IRI ---

<https://potato-hamlet.example/ontology/state/open> a ph:RequisitionOpen ;
  ph:label "Awaiting the Officer's decision" .

<https://potato-hamlet.example/ontology/state/approved> a ph:RequisitionApproved ;
  ph:label "Purchase authorised" .

<https://potato-hamlet.example/ontology/state/refused> a ph:RequisitionRefused ;
  ph:label "Purchase not authorised" .

<https://potato-hamlet.example/ontology/state/withdrawn> a ph:RequisitionWithdrawn ;
  ph:label "Withdrawn by the requester" .

<https://potato-hamlet.example/ontology/state/late> a ph:RequisitionLate ;
  ph:label "Decided after the deadline" .
