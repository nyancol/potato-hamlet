@prefix ph: <https://potato-hamlet.example/ontology/> .
@prefix gfo-core: <https://w3id.org/gfo-core/> .
@prefix gfo-light: <https://w3id.org/gfo-light/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Frozen schema (TBox): classes and properties only. Individuals live at
# runtime — seeded ones in population.ttl, minted ones by the oracle.
# Every ph: class subclasses a GFO-light/GFO-core category and is
# mirror-by-name with a Lean type in rules.lean.

# ------------------------------------------------------------------
# Framework invariants (required of every law)
# ------------------------------------------------------------------

ph:Citizen rdfs:subClassOf gfo-light:Object .
ph:Clock rdfs:subClassOf gfo-light:TimeBoundary .
ph:CalendarPoint rdfs:subClassOf gfo-light:TimeBoundary .
ph:CalendarSpan rdfs:subClassOf gfo-light:Chronoid .

ph:label a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf rdfs:label ;
  rdfs:range xsd:string .

ph:atDate a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:dateTimeValue .

# Domain is the GFO category, not a ph: subclass: the hour of a moment sits on
# ph:Clock, on a ph:CalendarPoint, and on the plain gfo-light:TimeBoundary
# individuals the oracle mints as a Chronoid's start and finish bounds.
ph:atHour a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:decimalValue ;
  rdfs:domain gfo-light:TimeBoundary ;
  rdfs:range xsd:integer .

# A span whose length is a gap rather than a position. The base calendar is
# frozen and shared by every repeat, so a phase due a fixed number of days
# after a runtime-minted instant cannot carry an absolute ph:dayIndex. It
# carries ph:gapDays instead, and the oracle mints the concrete bound per
# instance.
ph:gapDays a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:decimalValue ;
  rdfs:range xsd:integer .

# A day index names a moment, so it belongs on ph:Clock, on a
# ph:CalendarPoint, and on the plain gfo-light:TimeBoundary bounds the oracle
# mints -- and nowhere else. Functional because the oracle rewrites it with
# set-one: re-encoding an unchanged bound must not accumulate a value.
#
# Deliberately NOT functional: ph:marksPhase (one moment may mark several
# phases), ph:hasParticipant, ph:playedBy, ph:roleIn, ph:relates,
# ph:containsRole, ph:qualityOf, ph:causedBy. Those are genuinely set-valued
# and the oracle appends to them.
ph:dayIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:decimalValue ;
  rdfs:domain gfo-light:TimeBoundary ;
  rdfs:range xsd:integer .

# A calendar node names the Process phase it bounds. This is NOT the inverse
# of gfo-core:hasTime: that relation runs situation -> time and its object is
# an individual, whereas marksPhase's object is a phase CLASS. The base
# calendar is frozen and shared by every repeat, so it can only name a phase
# type — an instance does not exist yet at review time. Grounded by TYPE
# rather than by subproperty: a calendar node is the time of some process, so
# declaring subPropertyOf hasTime would assert something false.
ph:marksPhase a owl:ObjectProperty ;
  rdfs:domain gfo-light:Chronoid , gfo-light:TimeBoundary ;
  rdfs:range gfo-core:Process .

ph:age a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:decimalValue ;
  rdfs:domain ph:Citizen ;
  rdfs:range xsd:integer .

# ------------------------------------------------------------------
# Relationship vocabulary (framework, GFO-grounded)
# ------------------------------------------------------------------

# Composition: a Process is made of phases. Declared as class-level
# assertions, not someValuesFrom, so the hierarchy is enumerable.
ph:hasPhase a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-core:hasSituationPart .

ph:hasParticipant a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-core:hasParticipant .

# Direction is situation -> time; the Chronoid then carries the bounds.
# NOTE: timeOf is the INVERSE of hasTime in GFO, so this must subproperty
# hasTime. Subpropertying timeOf asserted the opposite direction.
# One Chronoid per instance: the oracle rewrites this with set-one on every
# apply, so it is functional like the datatypes below.
ph:hasTime a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:hasTime .

ph:relates a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-light:relates .

# ------------------------------------------------------------------
# Relations this law needs that GFO has no counterpart for. Each is
# grounded by TYPE, which law-extraction accepts: a reasoner still learns
# the relation's domain and range, which is what the grounding check asks.
#
# (Which citizen a thing belongs to lives in framework/physical.ttl as
# ph:ownedBy: the shared world relates its furniture that way, so the law
# draws on it rather than declaring it.)
# Which citizen a ballot stands for. A ballot is not a thing: a sheet of
# paper does not become a ballot by being written on, it PLAYS the role of
# one in this election. So the Role points at the candidate rather than
# carrying the candidate as a quality of the sheet, which would make the fact
# unconditional across elections -- and one supply of paper serves every
# election. What was WRITTEN is the sheet's own ph:label; what it MEANT is
# this, and the two may differ without anything being wrong.
ph:denotes a owl:ObjectProperty ;
  rdfs:domain gfo-light:Role ;
  rdfs:range gfo-light:Object .

# Where a ballot in THIS election was put. On the Role, not on the sheet:
# a sheet is a reusable physical object, so one left in a mailbox by an
# earlier election is still there for the next, and delivery recorded against
# the sheet would make a later ballot read as delivered before anyone carried
# it. The Role's IRI is a function of the occurrence, so scoping it there is
# free.
ph:deliveredTo a owl:ObjectProperty ;
  rdfs:domain gfo-light:Role ;
  rdfs:range gfo-light:Object .

ph:containsRole a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-light:containsRole .

ph:qualityOf a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-light:qualityOf .

# A State can bring about a change in a Process: permitted dependency,
# not an evaluated one. Never used for ordering between phases.
ph:causedBy a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-core:causedBy .

# Both sides of every Role.
ph:roleIn a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-light:roleIn .

ph:playedBy a owl:ObjectProperty ;
  rdfs:subPropertyOf gfo-light:playedBy .

# ------------------------------------------------------------------
# Law vocabulary
# ------------------------------------------------------------------

# The hamlet itself is declared once in framework/physical.ttl, like the
# physical classes below: it is what every law's text presupposes rather
# than vocabulary any law invents.
# ph:Townhall, ph:BallotBox, ph:Mailbox, ph:ResultsBoard and
# ph:CandidateRegistry are declared once in framework/physical.ttl and
# resolved alongside this file, not restated here: they are what this law's
# text presupposes rather than vocabulary this law invents.
ph:BallotVote rdfs:subClassOf gfo-light:Role .
ph:VoteResult rdfs:subClassOf gfo-light:InformationObject .

ph:MayorRole rdfs:subClassOf gfo-light:Role .
ph:CandidateRole rdfs:subClassOf gfo-light:Role .
ph:VoterRole rdfs:subClassOf gfo-light:Role .

# Roles for entities with more than one participant. `roleIn` gives the
# context, so a Citizen's roles in different situations never collide:
# a Citizen is a Voter of one cast vote and a BallotOwner of one ballot.
ph:BallotOwnerRole rdfs:subClassOf gfo-light:Role .

# Per-cycle transition flags. The oracle owns the transition; these record
# that it happened, and the verdict's `phase` is derived from them plus time.
ph:announced a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:booleanValue ;
  rdfs:domain ph:MayorElectionCycle ;
  rdfs:range xsd:boolean .

ph:prepared a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:booleanValue ;
  rdfs:domain ph:MayorElectionCycle ;
  rdfs:range xsd:boolean .

ph:counted a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:booleanValue ;
  rdfs:domain ph:MayorElectionCycle ;
  rdfs:range xsd:boolean .

ph:proclaimed a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:booleanValue ;
  rdfs:domain ph:MayorElectionCycle ;
  rdfs:range xsd:boolean .
ph:FallbackAuthorityRole rdfs:subClassOf gfo-light:Role .

ph:CitizenAge rdfs:subClassOf gfo-light:Quality .

ph:MayorElectionCycle rdfs:subClassOf gfo-core:Process .
ph:AnnounceElection rdfs:subClassOf gfo-core:Process .
ph:SelfNomination rdfs:subClassOf gfo-core:Process .
ph:CountVotes rdfs:subClassOf gfo-core:Process .
ph:ProclaimMayor rdfs:subClassOf gfo-core:Process .

# ------------------------------------------------------------------
# This law's two physical processes are SPECIALISATIONS of the shared ones,
# not declarations of their own.
#
# The same real moment is described twice. A physical `ph:Inscribe` has a hand
# and a sheet; the legal `ph:CreateBallots` has the authority and the ballot
# votes it must make. A physical `ph:Deposit` has a sheet going into a box; the
# legal `ph:CastVote` has a vote going into the ballot box. Two processes, the
# same gesture, related by the subclass rather than by a shared class -- which
# is what grounds the shared vocabulary in this law's hierarchy at all.
# ------------------------------------------------------------------

ph:CreateBallots rdfs:subClassOf ph:Inscribe .
ph:CastVote rdfs:subClassOf ph:Deposit .

ph:RegistryOpen rdfs:subClassOf gfo-core:State .
ph:BallotsReady rdfs:subClassOf gfo-core:State .
ph:PollsOpen rdfs:subClassOf gfo-core:State .
ph:PollsClosed rdfs:subClassOf gfo-core:State .
ph:ResultsPosted rdfs:subClassOf gfo-core:State .

ph:cycleIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:decimalValue ;
  rdfs:range xsd:integer .

# ------------------------------------------------------------------
# Declared process hierarchy
# The root Process and its constituent phases. Every phase below is
# reachable from ph:MayorElectionCycle through ph:hasPhase.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Declared participants: which Roles each Process class involves.
# The manifest's `holder_role` and `params[].role` must name a Role listed
# here for that ECA's `eca_process`, so the two cannot drift apart.
# ------------------------------------------------------------------

ph:AnnounceElection ph:hasParticipant ph:MayorRole ,
                                         ph:FallbackAuthorityRole .

ph:SelfNomination ph:hasParticipant ph:VoterRole ,
                                    ph:CandidateRole .

# Two roles, because two things are true of this phase at once: the AUTHORITY
# makes and delivers the papers, and the CITIZEN each set of papers is made out
# for. The citizen is a participant here because their mailbox is one of the
# objects the duty acts on -- "the mailbox of each citizen" (law.txt:12).
ph:CreateBallots ph:hasParticipant ph:MayorRole ,
                                 ph:FallbackAuthorityRole ,
                                 ph:BallotOwnerRole .

ph:CastVote ph:hasParticipant ph:VoterRole ,
                            ph:CandidateRole .

ph:CountVotes ph:hasParticipant ph:MayorRole .

ph:ProclaimMayor ph:hasParticipant ph:MayorRole .

ph:MayorElectionCycle ph:hasPhase
  ph:AnnounceElection ,
  ph:SelfNomination ,
  ph:CreateBallots ,
  ph:CastVote ,
  ph:CountVotes ,
  ph:ProclaimMayor .

ph:outcome a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:subPropertyOf gfo-core:stringValue ;
  rdfs:range xsd:string .
